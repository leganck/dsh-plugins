{
  "name": "@local/dsh-memory-archive",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle: for every compaction, write a greppable segment_NNN.md holding the checkpoint summary plus the verbatim shadowed turns, maintain INDEX.md, and inject a pointer so the model can recover early tool output. Same-session only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leganck/dsh-plugins.git",
    "directory": "plugins/dsh-memory-archive"
  },
  "homepage": "https://github.com/leganck/dsh-plugins/tree/main/plugins/dsh-memory-archive",
  "bugs": {
    "url": "https://github.com/leganck/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "compaction",
    "archive",
    "context"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "node test.mjs",
    "release": "pwsh -NoProfile -File build-plugin-dist.ps1"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "test.mjs",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "title": {
        "en": "Memory Archive",
        "zh": "会话记忆归档"
      },
      "description": {
        "en": "For every compaction, writes a greppable segment file with the verbatim shadowed turns, maintains an index, and injects a pointer so early tool output stays reachable.",
        "zh": "每次压缩把被折叠的逐字轮次写成可 grep 的段落文件，维护索引并注入指针，让早期工具输出在长会话里仍可检索。"
      },
      "category": "context",
      "labels": [
        "compaction",
        "archive"
      ],
      "icon": "./icon.svg"
    }
  },
  "author": "leganck",
  "icon": "./icon.svg"
}
