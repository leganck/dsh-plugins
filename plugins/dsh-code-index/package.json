{
  "name": "@local/dsh-code-index",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle: local codebase retrieval — SQLite FTS5 (BM25) + optional remote vectors/index/rerank (no local models). 0.12.0: ignore-aware scanning (.gitignore/.cursorignore), auto sync freshness, cross-lineage simhash adoption, settings page + snapshot scopes.",
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "tools",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "verify-install.mjs",
    "test.mjs",
    "test-plugin.mjs",
    "test-remote.mjs",
    "test-ignore.mjs",
    "test-auto-sync.mjs",
    "test-simhash.mjs",
    "test-workspace-roots.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "market": {
      "title": {
        "en": "Code Index",
        "zh": "代码索引"
      },
      "description": {
        "en": "Repository retrieval: local SQLite FTS5/BM25 keyword search plus optional remote semantic search and rerank, with AST chunking, directory map and change tracking.",
        "zh": "代码库检索：本地 SQLite FTS5/BM25 关键词检索 + 可选远端语义检索/重排，含 AST 切块、目录地图与变更追踪。"
      },
      "category": "retrieval",
      "labels": [
        "keyword-search",
        "semantic-search",
        "ast"
      ],
      "icon": "./icon.svg"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test-remote.mjs && node test.mjs && node test-ignore.mjs && node test-auto-sync.mjs && node test-simhash.mjs && node test-workspace-roots.mjs && node test-plugin.mjs",
    "test:remote": "node test-remote.mjs",
    "release": "node build-release.mjs"
  },
  "author": "leganck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leganck/dsh-plugins.git",
    "directory": "plugins/dsh-code-index"
  },
  "homepage": "https://github.com/leganck/dsh-plugins/tree/main/plugins/dsh-code-index",
  "bugs": {
    "url": "https://github.com/leganck/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "code-search",
    "bm25",
    "sqlite-fts5",
    "embeddings",
    "rag"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ignore": "^7.0.13"
  }
}
