# 复制成 .env 后 compose 会自动读取（`.env` 不进 git）
#
# 用哪个镜像：默认 cpu（开箱即用，≈0.3 GB）
IMAGE=ghcr.io/leganck/dsh-embed:latest-cpu

# 宿主机端口（只绑 127.0.0.1；对外用反代）
HOST_PORT=18000

# onnxruntime 线程数：留 1-2 核给系统
ORT_THREADS=6

# 后台嵌入限速（块/秒）：0 = 不限速；GPU 建库时用它别打满
EMBED_RATE=10

# 设了则写操作与数据类 GET 需要 Authorization: Bearer <key>；/health（最小字段）与 /admin（页面壳）免鉴权
# 客户端对应配置：插件 remote.apiKey / review-service INDEX_API_KEY
API_KEY=

# 存储上界（GB），超限返回 507
MAX_TOTAL_GB=20

# ---- 仅 compose.build.yaml 用 ----
# FLAVOR=cpu
# VERSION=dev
# MODEL_TARGET=embed
