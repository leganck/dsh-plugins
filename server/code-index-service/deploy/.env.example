# 复制成 .env 后 compose 会自动读取（`.env` 不进 git）
#
# 用哪个镜像：默认 cpu（开箱即用，≈0.3 GB）
IMAGE=ghcr.io/leganck/dsh-embed:latest-cpu

# 宿主机端口（只绑 127.0.0.1；对外用反代）
HOST_PORT=18000

# onnxruntime 线程数：留 1-2 核给系统
ORT_THREADS=6

# 后台嵌入限速（块/秒）：0 = 不限速；GPU 建库时用它别打满
EMBED_RATE=10

# 索引/检索客户端的 Bearer key（插件 remote.apiKey / review-service INDEX_API_KEY）；
# 设了则 sync/search/status 等接口都要带 Authorization: Bearer
API_KEY=

# 后台页面 /admin 与 /v1/admin/* 的 HTTP Basic 凭据；ADMIN_PASSWORD 为空则不启用
ADMIN_USER=admin
ADMIN_PASSWORD=

# 存储上界（GB），超限返回 507
MAX_TOTAL_GB=20

# ---- 仅 compose.build.yaml 用 ----
# FLAVOR=cpu
# VERSION=dev
# MODEL_TARGET=embed

# 模型挂载目录（配合 base-* 镜像 / compose.models.yaml / compose.jina.yaml）
MODELS_DIR=./models
