# ============ 部署（docker compose）============
# 复制成 .env 再改；这个文件本身不要提交（.gitignore 已忽略）

# ---- GitLab（必填）----
# bot 用户需要 Developer 角色 + PAT（scope=api），否则评论发不出去
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GitLab webhook 里配的 Secret token，必须与这里一致（明文比对，生产建议开 HTTPS）
WEBHOOK_SECRET=change-me-to-a-long-random-string
GITLAB_RPS=8

# ---- 模型（必填）----
# 任何 OpenAI 兼容网关都行：DeepSeek 官方 / 内网网关 / vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0

# ---- 评审行为（可调）----
DRY_RUN=0                    # 1 = 影子模式：只生成不发送
WORKERS=2                    # 并发 worker 数（每个 worker 一次处理一个 MR）
MIN_CONFIDENCE=0.7           # 低于此置信度的发现只进汇总
SEVERITY_FLOOR=minor         # 只发行内评论的严重度下限（critical|major|minor|trivial|info）
MAX_PER_FILE=3               # 单文件最多几条行内评论
MAX_TOTAL=15                 # 单个 MR 最多几条行内评论
MAX_FILES=30                 # 单次最多审多少个文件（超出按文件顺序截断）
MAX_LINES_PER_FILE=120       # 单文件最多展示多少新增行
MAX_DIFF_CHARS=60000
MAX_BLOCKS=6                 # Planner 分块上限
MAX_CONTEXT_CHUNKS=6         # 每块最多检索多少个相关代码片段
MAX_VERIFIER_STEPS=2         # Verifier 最多取证几轮
MAX_CANDIDATES=20
REVIEW_TIMEOUT=300
# 排除规则（逗号分隔）；默认已包含锁文件/产物目录
# IGNORE_GLOBS=*.lock,pnpm-lock.yaml,dist/**,vendor/**
# 规范文件候选（按顺序取第一个存在的）
# GUIDELINES_PATHS=AGENTS.md,CLAUDE.md,.cursorrules,.gitlab/ai-review.md

# ---- 预算（硬上限，超了会提前收敛并给出说明）----
MAX_LLM_CALLS=24
MAX_TOKENS_IN=160000
MAX_TOKENS_OUT=20000

# ---- 索引服务（可选，打通 code-index-service 后有跨文件上下文）----
# INDEX_URL=https://dsh-embed.example.com
# INDEX_API_KEY=
# 单仓库：直接给命名空间；多仓库：给 JSON 映射（project_id -> namespace）
# INDEX_NAMESPACE=energy@rev-2f3a1c
# INDEX_NAMESPACE_MAP={"12":"energy@rev-2f3a1c","13":"mall@rev-9a1b"}

# ---- 运行时 ----
DATA_DIR=/data
PORT=8000
HOST_PORT=18001


# ---- 取数策略（P1）----
# api = 只用 GitLab API（零磁盘，但 too_large 文件是盲区）
# clone = 镜像仓 + worktree + 本地 git diff（推荐；能建索引与图谱）
GIT_STRATEGY=clone
MIRROR_DIR=/data/mirrors
WORKTREE_DIR=/data/worktrees
MIRROR_TTL_DAYS=30
MAX_WORKTREES=6

# ---- 索引同步（可选，需要 code-index-service）----
INDEX_SYNC=1
INDEX_SYNC_MIN_INTERVAL=600
INDEX_REPO_PREFIX=repo
INDEX_CHUNK_FP=review-1

# ---- 代码图谱 ----
GRAPH_ENABLED=1
GRAPH_EVIDENCE_CONFIDENCE=0.8

# ---- 并行与预算 ----
REVIEW_CONCURRENCY=4
REVIEW_DEADLINE_S=300
