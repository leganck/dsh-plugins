{
  "name": "@local/dsh-memory-archive",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle: for every compaction, write a greppable segment_NNN.md holding the checkpoint summary plus the verbatim shadowed turns, maintain INDEX.md, and inject a pointer so the model can recover early tool output. Same-session only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.example.com/your-org/dsh-memory-archive.git"
  },
  "homepage": "https://git.example.com/your-org/dsh-memory-archive",
  "bugs": {
    "url": "https://git.example.com/your-org/dsh-memory-archive/-/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "compaction",
    "archive",
    "context"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.ps1",
    "test.mjs",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
